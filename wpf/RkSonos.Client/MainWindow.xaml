<Window x:Class="RkSonos.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RKSonos Client"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="860"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="打开(_O)…【占位！！】" Click="MenuOpen_Click"/>
        <Separator/>
        <MenuItem Header="退出(_X)" Click="MenuExit_Click"/>
      </MenuItem>
      <MenuItem Header="设置(_S)">
        <MenuItem Header="音乐库设置(_M)…" Click="MenuLibrarySettings_Click"/>
        <MenuItem Header="语言(_L)">
          <MenuItem Header="中文" Click="MenuLanguageZh_Click"/>
          <MenuItem Header="English" Click="MenuLanguageEn_Click"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="技术支持(_W)" Click="MenuSupport_Click"/>
        <MenuItem Header="检查更新(_U)" Click="MenuCheckUpdate_Click"/>
        <Separator/>
        <MenuItem Header="关于(_A)" Click="MenuAbout_Click"/>
      </MenuItem>
    </Menu>

    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Connection -->
      <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="服务器" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="TxtServer" Grid.Column="1" Text="http://192.168.1.252:8080" VerticalAlignment="Center"/>
          <Button x:Name="BtnConnect" Grid.Column="2" Content="连接" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="BtnConnect_Click"/>
          <Button x:Name="BtnRefresh" Grid.Column="3" Content="刷新" Click="BtnRefresh_Click"/>
          <Button x:Name="BtnSwitchDevice" Grid.Column="4" Content="切换设备" Margin="4,0,0,0" Click="BtnSwitchDevice_Click"/>
          <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <Ellipse x:Name="DotStatus" Width="10" Height="10" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtConn" Text="未连接" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Now playing + controls -->
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="正在播放" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="TxtNowPlaying" Text="—" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="TxtMeta" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
          </StackPanel>

          <!-- 进度条 -->
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*" MinWidth="120"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtPos" Text="0:00" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
            <Slider x:Name="SliderProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    Thumb.DragStarted="SliderProgress_DragStarted"
                    Thumb.DragDelta="SliderProgress_DragDelta"
                    Thumb.DragCompleted="SliderProgress_DragCompleted"
                    PreviewMouseLeftButtonUp="SliderProgress_PreviewMouseLeftButtonUp"/>
            <TextBlock x:Name="TxtDur" Grid.Column="2" Text="0:00" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
          </Grid>

          <!-- 标准播放器布局：模式 | 上一首 | 播放(居中大) | 下一首   ……   音量 -->
          <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 中间：模式 + 上一首 + 播放 + 下一首 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Button x:Name="BtnMode" Width="40" Height="40" Margin="0,0,10,0"
                      FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE8EE;"
                      ToolTip="播放模式: normal" Click="BtnMode_Click" Opacity="0.55"/>
              <Button x:Name="BtnPrev" Width="44" Height="44" Margin="0,0,10,0"
                      FontFamily="Segoe MDL2 Assets" FontSize="16" Content="&#xE892;"
                      ToolTip="上一首" Click="BtnPrev_Click"/>
              <Button x:Name="BtnPlayPause" Width="56" Height="56" Margin="0,0,10,0"
                      FontFamily="Segoe MDL2 Assets" FontSize="22" Content="&#xE768;"
                      Style="{StaticResource PlayButton}" ToolTip="播放/暂停" Click="BtnPlayPause_Click"/>
              <Button x:Name="BtnNext" Width="44" Height="44"
                      FontFamily="Segoe MDL2 Assets" FontSize="16" Content="&#xE893;"
                      ToolTip="下一首" Click="BtnNext_Click"/>
            </StackPanel>

            <!-- 右侧：音量 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
              <Slider x:Name="SliderVolume" Width="120" Minimum="0" Maximum="100" Value="50"
                      VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                      IsMoveToPointEnabled="False"
                      Thumb.DragStarted="SliderVolume_DragStarted"
                      Thumb.DragDelta="SliderVolume_DragDelta"
                      Thumb.DragCompleted="SliderVolume_DragCompleted"/>
              <TextBlock x:Name="TxtVolume" Text="50" Width="28" VerticalAlignment="Center" Margin="8,0,0,0"
                         Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Library + Queue -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock Text="音乐库" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtLibInfo" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,8,0,8">
              <Button x:Name="BtnLibBack" Content="← 返回" Margin="0,0,8,0" Click="BtnLibBack_Click" IsEnabled="False"/>
              <TextBlock x:Name="TxtLibPath" Text="文件夹" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
            <ListBox x:Name="ListLibrary" Grid.Row="2"
                     MouseDoubleClick="ListLibrary_MouseDoubleClick"
                     MouseLeftButtonUp="ListLibrary_MouseLeftButtonUp">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="播放" Click="CtxPlay_Click"/>
                  <MenuItem Header="添加到播放列表" Click="CtxAddQueue_Click"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock Text="播放列表" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtQueueCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" Text="0 首"/>
            </DockPanel>
            <ListBox x:Name="ListQueue" Grid.Row="1" Margin="0,8,0,8"
                     MouseDoubleClick="ListQueue_MouseDoubleClick">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="播放" Click="CtxQueuePlay_Click"/>
                  <MenuItem Header="移除" Click="CtxQueueRemove_Click"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <Run Text="{Binding Index, Mode=OneWay}"/><Run Text=". "/>
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <Button Content="清空" Click="BtnClearQueue_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Margin="0,10,0,0" Padding="4,2">
        <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
